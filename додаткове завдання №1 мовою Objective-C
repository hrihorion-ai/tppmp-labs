// ЗАВДАННЯ №3 3.1 Опишіть словник nDict, ключами якого є числові рядкові предсталення чисел від 1 до 5, 
// а відповідними значеннями є рядкові представлення чисел від 1 до 5 на англійській мові (наприклад, 1:One).

#import <Foundation/Foundation.h>

int main(int argc, const char * argv[]) {
    @autoreleasepool {
        NSDictionary *nDict = [NSDictionary dictionaryWithObjectsAndKeys:
            @"One", @"1",
            @"Two", @"2",
            @"Three", @"3",
            @"Four", @"4",
            @"Five", @"5",
            nil
        ];

        printf("1: %s\n", [[nDict objectForKey:@"1"] UTF8String]);
        printf("2: %s\n", [[nDict objectForKey:@"2"] UTF8String]);
        printf("3: %s\n", [[nDict objectForKey:@"3"] UTF8String]);
        printf("4: %s\n", [[nDict objectForKey:@"4"] UTF8String]);
        printf("5: %s\n", [[nDict objectForKey:@"5"] UTF8String]);
    }

    return 0;
}

// Результат виконання програми зі створення словника nDict мовою Objective-C.
// 1: One
// 2: Two
// 3: Three
// 4: Four
// 5: Five
